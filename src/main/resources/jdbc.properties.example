# 复制本文件为 src/main/resources/jdbc.properties 后填入真实连接信息。
# jdbc.properties 已在 .gitignore 中，不会被提交；也可以完全不建这个文件，
# 改用环境变量 JDBC_DRIVER / JDBC_URL / JDBC_USER / JDBC_PASSWORD / JDBC_MAX_ACTIVE
# 或系统属性 -Djdbc.url=... （优先级：系统属性 > 环境变量 > 本文件）。

driverClassName=com.mysql.cj.jdbc.Driver
url=jdbc:mysql://127.0.0.1:3306/your_database?useUnicode=true&characterEncoding=UTF-8&useSSL=false&serverTimezone=Asia/Shanghai
user=your_username
password=your_password

# sqlite
#driverClassName=org.sqlite.JDBC
#url=jdbc:sqlite:test.sqlite.db
#user=
#password=

maxActive=15
